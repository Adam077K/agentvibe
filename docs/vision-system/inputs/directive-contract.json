{
  "schema_version": 1,
  "kind": "Founder constraint",
  "source": "Founder message: AUTONOMOUS DISCOVERY, SYSTEM DESIGN, AND FULL IMPLEMENTATION DIRECTIVE, 2026-09-12",
  "transcription": "Structured requirements extraction, not a verbatim replacement of the original message. The original message wins any discrepancy.",
  "mission": "Discover, design, independently challenge, specify and fully implement a system enabling one responsible person or a small founding team to direct work at a scale they cannot personally perform or observe, across the entire company and project lifecycle.",
  "invariants": [
    "Company lifecycle scope exceeds coding and exceeds a collection of agents",
    "Determine required work, information, authority, consequences and evidence before choosing agents",
    "Preserve purpose, decisions and reasons, constraints, taste, promises, rejected alternatives, uncertainty, evidence, assumptions, omissions and changes of mind",
    "Distinguish founder decisions, system inference, system proposals, unknowns and expedient fallbacks",
    "Truthful account includes attempted, failed, skipped, assumed, inferred, unverifiable, stale, rejected, suppressed and unresolved work plus remaining consequences",
    "Autonomy follows consequence; track record may change review depth but never silently raise exposure",
    "Preserve owner competence through designed participation in customer evidence, taste, decisions and control",
    "No final architecture before independent expansion and competing alternatives",
    "Do not inherit old architecture, framework ontology, roster, stack or UI merely because it exists",
    "Never count a parsed, listed or claimed requirement as implemented without evidence"
  ],
  "execution": {
    "completion_bounded": true,
    "routine_confirmation": false,
    "research_stop_rule": "Every additional cycle must close a meaningful gap, test an assumption, investigate conflict, create a material alternative, attack a solution, improve coherence, cover a missing field, resolve dependency or improve an irreversible decision.",
    "persist_on_interruption": ["complete state", "completed work", "hypotheses", "disagreements", "exact next actions", "dependencies", "blockers", "risks", "examined sources and repo areas"],
    "survive": ["context compaction", "model changes", "provider changes", "process restarts", "machine restarts", "rate limits", "usage-limit resets", "network interruption", "tool failure", "agent/session transfer"],
    "escalate_only": ["personal intent", "values", "taste", "identity", "risk tolerance", "founder-only promise", "irreversible external commitment", "material legal or financial exposure", "equally defensible visions", "missing authorization", "founder-only information"],
    "decision_packet": ["exact decision", "why founder", "latest responsible time", "options", "consequences", "evidence", "uncertainty", "reversibility", "recommendation", "no-answer behavior", "independent work continuation"],
    "external_authority_not_granted": ["additional spend", "purchase", "public publication", "contact customers or strangers", "legal commitment", "accept contracts", "expose private data", "weaken security", "delete irreplaceable information", "consequential production deployment"]
  },
