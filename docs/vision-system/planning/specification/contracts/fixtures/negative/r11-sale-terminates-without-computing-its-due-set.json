            },
            "event_kind": "record.terminated",
            "observation_refs": {
              "arg": "observation_refs"
            },
            "decision_refs": {
              "arg": "decision_refs"
            }
          },
          {
            "op": "current_owner",
            "subject_ref": {
              "arg": "subject_ref"
            },
            "actor_ref": {
              "context": "actor_identity_ref"
            },
            "command": {
              "context": "command_name"
            }
          },
          {
            "op": "call",
            "predicate_id": "criterion.SalesAgreement.terminated.v1",
            "arguments": {
              "subject_ref": {
                "arg": "subject_ref"
              },
              "observation_refs": {
                "arg": "observation_refs"
              },
              "judgment_refs": {
                "arg": "judgment_refs"
              }
            }
          }
        ]
      }
    },
    {
      "file": "predicate-registry.json",
      "pointer": "/edge.SalesAgreement.accepted.terminated.v1/argument_types",
      "op": "replace",
      "value": {
        "subject_ref": "Ref<SalesAgreement>",
        "observation_refs": "Ref<Observation>[]",
