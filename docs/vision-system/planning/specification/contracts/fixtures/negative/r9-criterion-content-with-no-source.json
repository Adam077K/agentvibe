{
  "id": "r9-criterion-content-with-no-source",
  "repair": "R9",
  "finding": "FI-11 content",
  "why": "The defect F-canonical-01 named, reproduced exactly: criterion.Goal.parked.v1 is given a body that is BYTE-different from criterion.Goal.achieved.v1 (the predicate ids differ) and SHAPE-identical to it, and its derived_from is removed. Distinctness of bytes is not distinctness of guard, and a body with no citation is a requirement nobody can check against a source. Before the content checks landed, this validated.",
  "expect_failure_contains": "criterion states content with no derived_from",
  "patch": [
    {
      "file": "predicate-registry.json",
      "pointer": "/criterion.Goal.parked.v1/body",
      "op": "replace",
      "value": {
        "op": "all",
        "predicates": [
          {
            "op": "nonempty_fields",
            "subject_ref": {
              "arg": "subject_ref"
            },
            "field_paths": [
              "/payload/beneficiary",
              "/payload/outcome",
              "/payload/success_predicate",
              "/payload/qualitative_criteria",
              "/payload/reopen_predicate"
            ]
          },
          {
            "op": "native_correlated",
            "subject_ref": {
              "arg": "subject_ref"
            },
            "observation_refs": {
              "arg": "observation_refs"
            },
            "result": "observed_applied"
          },
          {
            "op": "accepted_for",
            "subject_ref": {
              "arg": "subject_ref"
            },
            "predicate_id": "criterion.Goal.parked.v1",
            "judgment_refs": {
              "arg": "judgment_refs"
            }
          },
          {
            "op": "attested_result",
            "subject_ref": {
              "arg": "subject_ref"
            },
            "predicate_id": "criterion.Goal.parked.v1",
            "predicate_version": "1.0",
            "observation_refs": {
              "arg": "observation_refs"
            }
          }
        ]
      }
    },
    {
      "file": "predicate-registry.json",
      "pointer": "/criterion.Goal.parked.v1/derived_from",
      "op": "remove"
    }
  ]
}