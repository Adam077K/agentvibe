racts/command-registry.json#/worker.claim"},{"id":"worker.checkpoint","owner_component":"S1-C03","payload":{"work_order_ref":"Ref<WorkOrder>","lease_epoch":"UInt64","registry_generation":"UInt64","continuation_ref":"Ref<Continuation>","artifact_refs":"Ref<ArtifactVersion>[]","observation_refs":"Ref<Observation>[]","usage_delta":"ResourceUsage[]","unfinished_obligation_refs":"Ref<Obligation>[]","operation_status_refs":"Ref<OperationStatus>[]"},"target_types":["WorkOrder","Continuation"],"read_only":false,"source_guard":null,"schema_ref":"commands.schema.json#/$defs/worker.checkpoint","guard_predicate_id":"command.worker.checkpoint.v1","guard_version":"1.0","guard_meaning":"worker.checkpoint exact typed command, target dispatch and protected boundary.","transaction_contract":{"isolation":"serializable, <=3 serialization retries, no external I/O while holding locks","idempotency":"command_id with exact canonical request digest; changed payload under same id conflicts","cas":"all expected business and lifecycle heads plus actual read dependencies; scope/epoch current reads included","commit":"one complete GroupBody without own future hash/proof; post-commit R independent durability before accepted","external_effect":"none implied; separate OperationIntent/Release/SendClaim and actual native reconciliation","on_failure":"typed reason, original result on retry, duties/holds retained","discriminator_checks":["record_type matches payload record_type and fields schema","target state belongs to exact registered subject type","proposed links match subject type and transition-owned roles","predicate IDs/version/argument schemas admitted; unregistered arbitrary predicates fail"]},"planned_module":"system/packages/work","implementation_status":null,"source_doc":"01-contract-kernel.md#8-domain-production-api-and-durable-work","source":"planning/specification/contracts/command-registry.json#/worker.checkpoint"},{"id":"worker.report","owner_component":"S1-C03","payload":{"work_order_ref":"Ref<WorkOrder>","lease_epoch":"UInt64","registry_generation":"UInt64","continuation_ref":"Ref<Continuation>","artifact_refs":"Ref<ArtifactVersion>[]","observation_refs":"Ref<Observation>[]","usage_delta":"ResourceUsage[]","unfinished_obligation_refs":"Ref<Obligation>[]","operation_status_refs":"Ref<OperationStatus>[]","outcome":"Enum<produced,failed,blocked,cancelled>","acceptance_evidence_refs":"EvidenceRef[]","error_class":"FailureClass?","unknown_influence_refs":"Ref<ReasonRecord>[]"},"target_types":["WorkOrder","AttemptReport"],"read_only":false,"source_guard":null,"schema_ref":"commands.schema.json#/$defs/worker.report","guard_predicate_id":"command.worker.report.v1","guard_version":"1.0","guard_meaning":"worker.report exact typed command, target dispatch and protected boundary.","transaction_contract":{"isolation":"serializable, <=3 serialization retries, no external I/O while holding locks","idempotency":"command_id with exact canonical request digest; changed payload under same id conflicts","cas":"all expected business and lifecycle heads plus actual read dependencies; scope/epoch current reads included","commit":"one complete GroupBody without own future hash/proof; post-commit R independent durability before accepted","external_effect":"none implied; separate OperationIntent/Release/SendClaim and actual native reconciliation","on_failure":"typed reason, original result on retry, duties/holds retained","discriminator_checks":["record_type matches payload record_type and fields schema","target state belongs to exact registered subject type","proposed links match subject type and transition-owned roles","predicate IDs/version/argument schemas admitted; unregistered arbitrary predicates fail"]},"planned_module":"system/packages/work","implementation_status":null,"source_doc":"01-contract-kernel.md#8-domain-production-api-and-durable-work","source":"planning/specification/contracts/command-registry.json#/worker.report"},{"id":"authority.grant.issue","owner_component":"S1-C04","payload":{"grant_payload":"GrantInput","issuer_assignment_ref":"Ref<ResponsibilityAssignment>","decision_record_ref":"Ref<DecisionRecord>","prerequisite_refs":"Ref<Record>[]"},"target_types":["Grant"],"read_only":false,"source_guard":null,"schema_ref":"commands.schema.json#/$defs/authority.grant.issue","guard_predicate_id":"command.authority.grant.issue.v1","guard_version":"1.0","guard_meaning":"authority.grant.issue exact typed command, target dispatch and protected boundary.","transaction_contract":{"isolation":"serializable, <=3 serialization retries, no external I/O while holding locks","idempotency":"command_id with exact canonical request digest; changed payload under same id conflicts","cas":"all expected business and lifecycle heads plus actual read dependencies; scope/epoch current reads included","commit":"one complete GroupBody without own future hash/proof; post-commit R independent durability before accepted","external_effect":"none implied; separate OperationIntent/Release/SendClaim and actual native reconciliation","on_failure":"typed reason, original result on retry, duties/holds retained","discriminator_checks":["record_type matches payload record_type and fields schema","target state belongs to exact registered subject type","proposed links match subject type and transition-owned roles","predicate IDs/version/argument schemas admitted; unregistered arbitrary predicates fail"]},"planned_module":"system/packages/authority","implementation_status":null,"source_doc":"02-authority-recovery.md#62-ordered-preparation-release-and-send-claim","source":"planning/specification/contracts/command-registry.json#/authority.grant.issue"},{"id":"authority.grant.attenuate","owner_component":"S1-C04","payload":{"parent_grant_ref":"Ref<Grant>","proposed_child_payload":"GrantInput","attenuation_proof_ref":"Ref<Observation>"},"target_types":["Grant"],"read_only":false,"source_guard":null,"schema_ref":"commands.schema.json#/$defs/authority.grant.