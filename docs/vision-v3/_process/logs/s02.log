docs/vision-system/planning/specification/contracts/fixtures/negative/r18-derivation-written-outside-the-release-path.json:5:  "case": "The consequence derivation is written by a component other than the release path.",
docs/vision-system/planning/specification/contracts/fixtures/negative/r18-derivation-written-outside-the-release-path.json:6:  "paired_benign_fixture": "fixtures/positive/r18-derivation-written-outside-the-release-path-benign.json",
docs/vision-system/planning/specification/contracts/fixtures/negative/MANIFEST.json:63:    "r18-derivation-written-outside-the-release-path",
