ortfolio.ts","system/packages/authority/interactions.ts"],"status":"planned-not-existing"},"planned_test":{"id":"CHT-F24-Q09","location":"system/tests/company-human/f24-q09.test.ts","case":"Omit a failed venture's source feed; display the gap and last observed duties in the portfolio instead of a complete green aggregate.","ordinary_control":"Also perform the nearest fully authorized ordinary path with valid exact prerequisites; refusal alone cannot pass.","evidence_required":"Attributable original observations, exact subject/predicate judgment where applicable, current authority and remaining duties; fixtures explicitly synthetic.","status":"unexecuted"},"status":"specified-pending-independent-review","implementation_status":"specified-unimplemented","completion_claim":false,"provider_route_contracts":{"route_ids":["IC-HUMAN"],"location":"07-integrations-capacity.md#3-selected-fulfillment-adapters","source_commit":"2807d06c4b934499c03959b9ddbe98c4016d7897","state":"selected-specification; not connected, configured or admitted","remaining":"Actual account/principal/terms, fees, authority, clean-context/disclosure admission and competent performer/capacity evidence remain required; manual fallback is real attributed performance, not a packet."},"source":"planning/specification/capabilities.json#/source_question_contracts/59"},{"question_id":"F24-Q10","source_field":24,"question":"How does something learned in one get used in another without contaminating it?","answer":"Propose a scoped KnowledgeEntry/LearningProposal with originals, rival explanations and applicability limits. C05 verifies current recipient/purpose rights and compatible entity/time/semantic meaning before transfer. A new venture tests applicability with its own evidence; copied success is neither consent to share data nor proof of market fit.","answer_location":"capabilities.json#/source_question_contracts/60","source_contract_location":"03-company-capabilities.md#incidents-knowledge-growth-and-responsible-ending","trace_decision_location":"09-company-human-traceability.md#ventures-and-shared-consequences","related_capabilities":["CAP-22","CAP-32","CAP-34"],"supporting_contracts":[{"subject":"KnowledgeEntry","location":"capabilities.json#/record_types/KnowledgeEntry","binding_note":"Domain view/extension; resolve through catalog record_bindings to the exact canonical type."},{"subject":"LearningProposal","location":"capabilities.json#/record_types/LearningProposal","binding_note":"Domain view/extension; resolve through catalog record_bindings to the exact canonical type."},{"subject":"ContextManifest","location":"01-contract-kernel.md#7-core-relationships-and-exact-state-transitions","binding_note":"Definition, projection or composition retains its source contract; this trace creates no additional authority record."},{"subject":"SemanticMappingVersion","location":"01-contract-kernel.md#11-contract-evolution-scaling-and-removal","binding_note":"Definition, projection or composition retains its source contract; this trace creates no additional authority record."}],"supporting_capability_contracts":["capabilities.json#/capabilities/21","capabilities.json#/capabilities/31","capabilities.json#/capabilities/33"],"decision_refs":[{"id":"CHT-D03","location":"09-company-human-traceability.md#ventures-and-shared-consequences","status":"adopted-S1-contract-application; no new architecture"}],"evidence_refs":[{"location":"03-company-capabilities.md#incidents-knowledge-growth-and-responsible-ending","kind":"selected-specification","supports":"Normative answer and procedure responsibility; not observed operating success."},{"location":"../../research/L02-operations.md","kind":"primary-supported-research-archive","supports":"Bounded background evidence and limits summarized in the selected contracts; no studies repeated here."},{"location":"../02-architecture-selection.md","kind":"adopted-logical-foundation","supports":"S1.0 authority and responsibility boundaries; no empirical superiority."},{"location":"08-improvement-implementation.md#3-repository-and-process-implementation-target","source_commit":"2807d06c4b934499c03959b9ddbe98c4016d7897","kind":"planned-construction-contract","supports":"Selected package/component boundaries only; listed per-question files are proposed construction locations, not existing modules."}],"uncertainty":"Actual principal separation, shared obligations, transferable rights, human attention and failure independence require setup evidence and exercised operation.","planned_implementation":{"component_ids":["S1-C03","S1-C05","S1-C07"],"modules":["system/packages/company/direction/portfolio.ts","system/packages/authority/interactions.ts"],"status":"planned-not-existing"},"planned_test":{"id":"CHT-F24-Q10","location":"system/tests/company-human/f24-q10.test.ts","case":"Transfer a useful onboarding lesson across ventures with different audiences; retain limits, prevent private-source leakage and require the new audience's actual test.","ordinary_control":"Also perform the nearest fully authorized ordinary path with valid exact prerequisites; refusal alone cannot pass.","evidence_required":"Attributable original observations, exact subject/predicate judgment where applicable, current authority and remaining duties; fixtures explicitly synthetic.","status":"unexecuted"},"status":"specified-pending-independent-review","implementation_status":"specified-unimplemented","completion_claim":false,"source":"planning/specification/capabilities.json#/source_question_contracts/60"},{"question_id":"F25-Q01","source_field":25,"question":"Deciding what to build and for whom · designing how it looks and feels · building it · testing it · running it once it exists · finding the people who might want it · talking to them · selling · supporting them afterwards · keeping the books · staying on the right side of rules and contracts · researching what is true about the market · negotiating with suppliers · hiring and its equivalent here · and the question underneath all of them: does each of these need its own worker, or is it a way of working that any worker can adopt?","answer":"These are distinct procedures and acceptance responsibilities, not a permanent worker roster. CAP-03/04/05 investigate beneficiary and market, CAP-06/07 choose and specify an offer, CAP-08/09 design experience and identity, CAP-10/11 build and independently assess it, and CAP-12/30 launch and actually operate/deliver it. CAP-13/14 produce and distribute real assets; CAP-16/15 conduct actual conversations and exact-term sales; CAP-17/42 repair and remedy; CAP-19/20 reconcile money and books; CAP-21/22/40 obtain actual institutional determinations/readiness; CAP-24/25 negotiate and verify suppliers/partners; CAP-26/27 obtain competent people with accepted mandates. Finite WorkflowDefinition steps select deterministic procedures, temporary model instances, actual humans, professionals or services according to input, consequence and evidence needs. The linked job_routes specify each named job's intake-to-acceptance path; supporting_capability_contracts covers all 46 outcomes, including analytics, learning, security, continuity, pivot and closure. A packet to an unavailable professional, text describing an unproduced asset, or an unaccepted task handoff never completes the business job. The committed IC1 routes use Brave plus authorized fetch, Fastmail intake, Postmark controlled send, Cloudflare public assets/forms, Stripe payment reconciliation, original statements plus hledger, and accepted human/professional performance. Specialized media or venture-specific physical service still needs an admitted actual creator/performer.","answer_location":"capabilities.json#/source_question_contracts/61","source_contract_location":"capabilities.json","trace_decision_location":"09-company-human-traceability.md#complete-company-procedures","related_capabilities":["CAP-01","CAP-02","CAP-03","CAP-04","CAP-05","CAP-06","CAP-07","CAP-08