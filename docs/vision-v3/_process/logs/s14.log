cification/capabilities.json#/source_question_contracts/50"},{"question_id":"F24-Q01","source_field":24,"question":"What makes two efforts genuinely separate?","answer":"Separate efforts have explicit purpose, sponsor, beneficiaries, promises, resources and native field authority; legal principals are actual facts, not inferred from venture IDs. Shared accounts, people, data or counterparties create interaction determinations even when brands differ. Logical separation is therefore tested against actual overlapping consequences.","answer_location":"capabilities.json#/source_question_contracts/51","source_contract_location":"03-company-capabilities.md#incidents-knowledge-growth-and-responsible-ending","trace_decision_location":"09-company-human-traceability.md#ventures-and-shared-consequences","related_capabilities":["CAP-02","CAP-33","CAP-40"],"supporting_contracts":[{"subject":"Venture","location":"capabilities.json#/record_types/Venture","binding_note":"Domain view/extension; resolve through catalog record_bindings to the exact canonical type."},{"subject":"IntentVersion","location":"01-contract-kernel.md#4-intent-knowledge-rationale-and-events","binding_note":"Definition, projection or composition retains its source contract; this trace creates no additional authority record."},{"subject":"InteractionDetermination","location":"01-contract-kernel.md#7-core-relationships-and-exact-state-transitions","binding_note":"Definition, projection or composition retains its source contract; this trace creates no additional authority record."}],"supporting_capability_contracts":["capabilities.json#/capabilities/1","capabilities.json#/capabilities/32","capabilities.json#/capabilities/39"],"decision_refs":[{"id":"CHT-D03","location":"09-company-human-traceability.md#ventures-and-shared-consequences","status":"adopted-S1-contract-application; no new architecture"}],"evidence_refs":[{"location":"03-company-capabilities.md#incidents-knowledge-growth-and-responsible-ending","kind":