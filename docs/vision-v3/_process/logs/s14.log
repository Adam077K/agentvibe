nswer":"Pause specified new work through PausePlan while retaining support, payments, reporting, data and grievance custody. Record review dates and expiring accounts, contracts, people, evidence, context and reserves. Resume rechecks actual capacity, current permissions, independent recovery frontier and unknown effects; a saved snapshot cannot restore expired standing.","answer_location":"capabilities.json#/source_question_contracts/56","source_contract_location":"03-company-capabilities.md#incidents-knowledge-growth-and-responsible-ending","trace_decision_location":"09-company-human-traceability.md#ventures-and-shared-consequences","related_capabilities":["CAP-36","CAP-37","CAP-42"],"supporting_contracts":[{"subject":"PausePlan","location":"capabilities.json#/record_types/PausePlan","binding_note":"Domain view/extension; resolve through catalog record_bindings to the exact canonical type."},{"subject":"RecoveryPacket","location":"capabilities.json#/record_types/RecoveryPacket","binding_note":"Domain view/extension; resolve through catalog record_bindings to the exact canonical type."},{"subject":"DeliveryCapacity","location":"capabilities.json#/record_types/DeliveryCapacity","binding_note":"Domain view/extension; resolve through catalog record_bindings to the exact canonical type."},{"subject":"DeletionScope","location":"01-contract-kernel.md#7-core-relationships-and-exact-state-transitions","binding_note":"Definition, projection or composition retains its source contract; this trace creates no additional authority record."}],"supporting_capability_contracts":["capabilities.json#/capabilities/35","capabilities.json#/capabilities/36","capabilities.json#/capabilities/41"],"decision_refs":[{"id":"CHT-D03","location":"09-company-human-traceability.md#ventures-and-shared-consequences","status":"adopted-S1-contract-application; no new architecture"}],"evidence_refs":[{"location":"03-company-capabilities.md#incidents-knowledge-growth-and-responsible-ending","kind":"sele