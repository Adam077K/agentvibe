{
  "name": "gsa-startup-kit",
  "version": "1.1.0",
  "description": "AI Agent Kit for Claude Code & Antigravity — autonomous startup team (CEO, C-suite, Workers) with 147 expert skills",
  "bin": {
    "gsa-startup-kit": "bin/install.js"
  },
  "scripts": {
    "check": "npm run lint:agents && npm run test:gate && npm run check:manifest && npm run check:registration && npm run check:warroom && npm run check:ledger",
    "check:ledger": "npm run test:claims && npm run test:classifier && npm run test:ledger && node scripts/ledger.mjs lint && node scripts/ledger.mjs build --check && node scripts/ledger.mjs verify",
    "test:claims": "node --test scripts/claims.test.mjs",
    "test:classifier": "node --test scripts/classifier.test.mjs",
    "test:ledger": "node --test scripts/ledger.test.mjs",
    "ledger:build": "node scripts/ledger.mjs build",
    "ledger:verify": "node scripts/ledger.mjs verify",
    "ledger:events": "node scripts/ledger.mjs events --since 30d",
    "ledger:views": "node scripts/ledger.mjs views",
    "check:warroom": "bash -n bin/warroom && node --check scripts/warroom-install.mjs && bash -n scripts/warroom-parity.sh && npm run test:warroom",
    "test:warroom": "node --test scripts/warroom-install.test.mjs",
    "warroom:fleet": "node scripts/warroom-install.mjs fleet",
    "warroom:check": "node scripts/warroom-install.mjs check",
    "lint:agents": "node .claude/hooks/schema-lint.js",
    "test:gate": "node --test .claude/workflows/lib/gate-logic.test.mjs",
    "check:manifest": "node scripts/build-skills-manifest.mjs --check",
    "check:registration": "node scripts/check-registration.mjs",
    "build:manifest": "node scripts/build-skills-manifest.mjs"
  },
  "files": [
    "bin/",
    ".claude/agents/",
    ".claude/commands/",
    ".claude/hooks/",
    ".claude/package.json",
    ".claude/settings.json",
    "docs/",
    "AGENTS.md",
    "CLAUDE.md",
    "SKILLS_SOURCE.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "antigravity",
    "startup-kit",
    "agent-kit",
    "gsa",
    "multi-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adam077K/GSA-Vibe-Startup-Kit"
  },
  "homepage": "https://github.com/Adam077K/GSA-Vibe-Startup-Kit#readme"
}
