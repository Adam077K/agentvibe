{
  "name": "gsa-startup-kit",
  "version": "1.1.0",
  "description": "AI Agent Kit for Claude Code & Antigravity \u2014 autonomous startup team (CEO, C-suite, Workers) with 147 expert skills",
  "bin": {
    "gsa-startup-kit": "bin/install.js"
  },
  "scripts": {
    "check": "node scripts/run-checks.mjs",
    "check:ci-chains": "node scripts/check-ci-chains.mjs",
    "test:check-suite": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/check-suite.test.mjs",
    "test:tier-gate": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/check-tier-gate.test.mjs",
    "test:sandbox": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/sandbox-config.test.mjs",
    "check:mc": "node mission-control/check.mjs",
    "test:probe-readonly": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/probe-readonly.test.mjs",
    "test:pre-tool-use": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/pre-tool-use.test.mjs",
    "test:run-gate": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/run-gate.test.mjs",
    "test:merge-gate": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/merge-gate.test.mjs",
    "verdict": "node scripts/verdict.mjs",
    "test:skill-clamp": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/skill-clamp.test.mjs",
    "test:probe-stop-reason": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/probe-stop-reason.test.mjs",
    "test:launcher-permissions": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/launcher-permissions.test.mjs",
    "probe:stop-reason": "node scripts/probe-stop-reason.mjs",
    "gate": "node scripts/run-gate.mjs",
    "test:lenses": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/lenses.test.mjs",
    "test:provenance": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/provenance-portability.test.mjs",
    "vendor:provenance": "node scripts/vendor-provenance.mjs",
    "check:ledger": "npm run test:claims && npm run test:classifier && npm run test:ledger && npm run check:ledger-lint && npm run check:ledger-build && npm run check:ledger-verify",
    "check:ledger-lint": "node scripts/ledger.mjs lint",
    "check:ledger-build": "node scripts/ledger.mjs build --check",
    "check:ledger-verify": "node scripts/ledger.mjs verify",
    "test:claims": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/claims.test.mjs",
    "test:classifier": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/classifier.test.mjs",
    "test:ledger": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/ledger.test.mjs",
    "ledger:build": "node scripts/ledger.mjs build",
    "ledger:verify": "node scripts/ledger.mjs verify",
    "ledger:events": "node scripts/ledger.mjs events --since 30d",
    "ledger:views": "node scripts/ledger.mjs views",
    "check:warroom": "npm run check:warroom-launcher && npm run check:warroom-template && npm run check:warroom-installer && npm run check:warroom-parity && npm run test:warroom",
    "check:warroom-launcher": "bash -n bin/warroom",
    "check:warroom-template": "bash -n war-room/bin/PROJECT_NAME.tmpl",
    "check:warroom-installer": "node --check scripts/warroom-install.mjs",
    "check:warroom-parity": "bash -n scripts/warroom-parity.sh",
    "test:warroom": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/warroom-install.test.mjs scripts/warroom-template-guard.test.mjs",
    "warroom:fleet": "node scripts/warroom-install.mjs fleet",
    "warroom:check": "node scripts/warroom-install.mjs check",
    "lint:agents": "node .claude/hooks/schema-lint.js",
    "check:prompt-standard": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/prompt-standard.test.mjs",
    "test:gate": "node --require ./scripts/protected-write-tripwire.cjs --test .claude/workflows/lib/gate-logic.test.mjs",
    "check:manifest": "node scripts/build-skills-manifest.mjs --check",
    "check:registration": "node scripts/check-registration.mjs",
    "test:registration": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/check-registration.test.mjs",
    "check:dispatch": "npm run test:dispatch && npm run test:dispatch-flush && npm run check:dispatch-agenttype",
    "check:dispatch-agenttype": "node scripts/check-dispatch-agenttype.mjs",
    "test:dispatch": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/check-dispatch-agenttype.test.mjs",
    "test:dispatch-flush": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/check-dispatch-flush.test.mjs",
    "check:dispatch-prompt": "npm run test:dispatch-prompt && npm run check:dispatch-prompt-size",
    "check:dispatch-prompt-size": "node scripts/check-dispatch-prompt-size.mjs",
    "test:dispatch-prompt": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/check-dispatch-prompt-size.test.mjs",
    "check:memory": "npm run test:memory && npm run test:eviction && npm run check:memory-budget",
    "check:memory-budget": "node scripts/check-memory-budget.mjs",
    "test:memory": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/check-memory-budget.test.mjs",
    "test:eviction": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/evict-memory.test.mjs",
    "memory:evict": "node scripts/evict-memory.mjs",
    "check:citations": "npm run test:citations && node scripts/check-citations.mjs",
    "test:citations": "node --test scripts/check-citations.test.mjs",
    "build:manifest": "node scripts/build-skills-manifest.mjs",
    "test:playbooks": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/playbooks.test.mjs",
    "ledger:sweep": "node scripts/ledger.mjs sweep",
    "test:hooks": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/session-start.test.mjs",
    "test:budget": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/usage.test.mjs",
    "usage": "node -e \"const u=require('./scripts/lib/usage.js');const w=u.windowUsage({});console.log(w.output_tokens.toLocaleString()+' output tokens in the rolling '+w.window_hours+'h window')\"",
    "build:map": "node scripts/gen-codebase-map.mjs",
    "check:map": "node scripts/gen-codebase-map.mjs --check",
    "curate:skills": "node scripts/curate-skills.mjs",
    "check:curation": "node scripts/curate-skills.mjs --check",
    "build:routers": "node scripts/build-skill-routers.mjs",
    "check:routers": "node scripts/build-skill-routers.mjs --check",
    "measure:bash": "node scripts/measure-bash-usage.mjs",
    "test:protected-write": "node --require ./scripts/protected-write-tripwire.cjs --test scripts/protected-write.test.mjs"
  },
  "files": [
    "bin/",
    ".claude/agents/",
    ".claude/commands/",
    ".claude/hooks/",
    ".claude/package.json",
    ".claude/settings.json",
    "docs/",
    "AGENTS.md",
    "CLAUDE.md",
    "SKILLS_SOURCE.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "antigravity",
    "startup-kit",
    "agent-kit",
    "gsa",
    "multi-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adam077K/GSA-Vibe-Startup-Kit"
  },
  "homepage": "https://github.com/Adam077K/GSA-Vibe-Startup-Kit#readme"
}
