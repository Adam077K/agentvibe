# Local-only: disabled skills for lean configuration
# These skills are kept in the repository but disabled locally
.disabled/

# Local / secrets
.env
.env.*
!.env.example
*.local

# OS
.DS_Store
Thumbs.db

# Git worktrees (agent isolated work branches)
.worktrees/

# Large skills backup directory (live skills are .claude/skills/)
all_skills_stored/

# Generated install output of war-room/dashboard/ — never edit here, edit the
# source and re-run bin/install-war-room.sh
war-room-dashboard/

# Local Claude permissions (machine-specific)
.claude/settings.local.json

# Installed dependencies (mission-control/ — the first thing in this repo with a lockfile)
node_modules/

# Mission Control's built client — server + rail only in this PR, no client build yet
mission-control/client/dist/

# IDE / tool caches (keep config, ignore caches)
.claude/memory/*.local.md
.planning/state.local.json

# Ledger run log — only used when no ~/.<session>/events.jsonl is configured
.ledger-events.jsonl

# claim-append's write lock and its atomic-rename staging file. Both exist only while
# scripts/lib/claim-append.js is mid-write; a committed one would mean an append died.
docs/03-system-design/.SOURCED-CLAIMS.lock
docs/03-system-design/SOURCED-CLAIMS.md.*.tmp
.claude/ledger/index.json.*.tmp

# Perception-loop output — evidence, never a deliverable. A binary file is committed only if it
# is the deliverable. Re-derivable from a commit; never committed.
design/captures/
